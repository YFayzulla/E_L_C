APP_NAME=ALPHA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Verification links are signed against APP_URL. If it does not match the origin
# the user actually browses, every link fails with "Invalid signature".
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=learning_center
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. QUEUE_CONNECTION=sync means sends happen inside the HTTP request, so an
# unreachable SMTP host throws mid-request. Use `log` in development (the mail
# lands in storage/logs/laravel.log) and real SMTP only in production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@alpha.uz"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (Eskiz — notify.eskiz.uz) -------------------------------------------
# NOTHING is sent until BOTH of these are filled in. Without them the app just
# logs "not configured" and carries on — no request leaves the server.
# Credentials come from your Eskiz cabinet: https://my.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Sender nickname. 4546 is Eskiz's shared TEST sender and only delivers texts
# Eskiz has pre-approved — free-form messages need your own approved nickname.
ESKIZ_FROM=4546

# Master switch and rehearsal mode.
#   ESKIZ_ENABLED=false  -> keep credentials but stop sending entirely
#   ESKIZ_DRY_RUN=true   -> resolve recipients and log the text, send nothing
ESKIZ_ENABLED=true
ESKIZ_DRY_RUN=false

# Delivery reports. Must be publicly reachable; leave empty to disable.
# ESKIZ_CALLBACK_URL="${APP_URL}/sms/callback"
ESKIZ_CALLBACK_URL=

# Numbers that must never receive a real SMS (comma separated, 998XXXXXXXXX).
ESKIZ_BLOCKLIST=998999999999

# Check the connection without sending:  php artisan sms:check
# Send one real test message:            php artisan sms:check --to=901234567

# Account e-mail confirmation for students and teachers.
#
# false (default) — an address can be saved and confirmed, and an unconfirmed
#                   account only sees a reminder banner. Nobody is locked out.
# true            — students and teachers WHO HAVE AN ADDRESS must confirm it
#                   before they can use the app. Accounts with no address are
#                   never blocked, and admins are never blocked.
#
# Before switching this on: fill in the addresses, or grandfather the existing
# accounts with `php artisan users:verify-email --all`.
REQUIRE_EMAIL_VERIFICATION=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
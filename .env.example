APP_NAME=ALPHA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Verification links are signed against APP_URL. If it does not match the origin
# the user actually browses, every link fails with "Invalid signature".
APP_URL=http://localhost

# ---------------------------------------------------------------- MULTI-TENANT
#
# Har bir o'quv markazi shu domenning o'z subdomenida yashaydi:
#   alpha.domen.uz, beta.domen.uz — DNS da wildcard yozuvi kerak: *.domen.uz
# Apexning o'zi (domen.uz) markazsiz: kirish, markaz tanlash va super-admin.
#
# LOKALDA `localhost` QO'YMANG. Windows `*.localhost` ni hal qilmaydi —
# alpha.localhost brauzerda umuman ochilmaydi (macOS/Linux da ochiladi).
# Ikki yo'l bor:
#
#   1) localtest.me — hech narsa sozlash shart emas. Bu ommaviy DNS
#      yozuvi bo'lib, *.localtest.me ning hammasi 127.0.0.1 ga qaraydi.
#      Administrator huquqi ham, hosts fayliga tegish ham kerak emas.
#      Manzillar: http://alpha.localtest.me:8000
#
#   2) hosts fayli — internetsiz ishlaydi, lekin Administrator kerak.
#      C:\Windows\System32\drivers\etc\hosts ga har bir markaz uchun
#      bittadan qator: `127.0.0.1 alpha.localhost`
#
APP_DOMAIN=localtest.me
APP_SCHEME=http

# Markaz nomlanmagan host uchun qaysi markaz olinsin (slug).
#
# Bu — ko'chish davri uchun eshik: eski o'rnatma qaysi manzilda ishlagan
# bo'lsa, o'shanda ishlayvergani uchun mavjud foydalanuvchilar hech narsani
# sezmaydi. Haqiqiy subdomenlarga o'tgach BO'SHATING — shundagina apex
# o'ziga tegishli kirish/tanlash sahifasiga aylanadi.
#
# DIQQAT: bo'sh bo'lsa VA host subdomen bermasa (masalan 127.0.0.1),
# ilova har bir sahifada 404 qaytaradi — markaz aniqlanmaydi.
APP_DEFAULT_CENTRE=alpha

# Sessiya barcha subdomenlar bo'ylab umumiy bo'lishi kerak, aks holda
# markaz almashtirish har safar qayta kirishni talab qiladi.
#
# SESSION_COOKIE ni ANIQ yozing: standart qiymat APP_NAME dan olinadi,
# ya'ni markaz nomi o'zgarsa hamma tizimdan chiqib ketadi.
SESSION_COOKIE=elc_session
SESSION_DOMAIN=.localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=learning_center
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. QUEUE_CONNECTION=sync means sends happen inside the HTTP request, so an
# unreachable SMTP host throws mid-request. Use `log` in development (the mail
# lands in storage/logs/laravel.log) and real SMTP only in production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@alpha.uz"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (Eskiz — notify.eskiz.uz) -------------------------------------------
# NOTHING is sent until BOTH of these are filled in. Without them the app just
# logs "not configured" and carries on — no request leaves the server.
# Credentials come from your Eskiz cabinet: https://my.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Sender nickname. 4546 is Eskiz's shared TEST sender and only delivers texts
# Eskiz has pre-approved — free-form messages need your own approved nickname.
ESKIZ_FROM=4546

# Master switch and rehearsal mode.
#   ESKIZ_ENABLED=false  -> keep credentials but stop sending entirely
#   ESKIZ_DRY_RUN=true   -> resolve recipients and log the text, send nothing
ESKIZ_ENABLED=true
ESKIZ_DRY_RUN=false

# Delivery reports. Must be publicly reachable; leave empty to disable.
# ESKIZ_CALLBACK_URL="${APP_URL}/sms/callback"
ESKIZ_CALLBACK_URL=

# Numbers that must never receive a real SMS (comma separated, 998XXXXXXXXX).
ESKIZ_BLOCKLIST=998999999999

# Check the connection without sending:  php artisan sms:check
# Send one real test message:            php artisan sms:check --to=901234567

# Account e-mail confirmation for students and teachers.
#
# false (default) — an address can be saved and confirmed, and an unconfirmed
#                   account only sees a reminder banner. Nobody is locked out.
# true            — students and teachers WHO HAVE AN ADDRESS must confirm it
#                   before they can use the app. Accounts with no address are
#                   never blocked, and admins are never blocked.
#
# Before switching this on: fill in the addresses, or grandfather the existing
# accounts with `php artisan users:verify-email --all`.
REQUIRE_EMAIL_VERIFICATION=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
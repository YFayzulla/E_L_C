<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned so the suite never depends on a developer's .env. This key
             protects nothing: the test database is in memory and thrown away. -->
        <env name="APP_KEY" value="base64:Xj9K2mQvN7pR4sT8wY1zA3bC5dE6fG7hI8jK9lM0nO4="/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <!-- A file, not :memory:. An in-memory SQLite database belongs to the
             connection that opened it, so anything that reconnects mid-test
             silently gets a second, empty database — deletes appear to run and
             then "come back". A file behaves like the real thing. -->
        <env name="DB_DATABASE" value="database/testing.sqlite"/>
        <!-- Composite foreign keys are how tenant drift is made impossible.
             SQLite ignores every FK unless this is on, so without it the
             tests would pass on data MySQL would have rejected. -->
        <env name="DB_FOREIGN_KEYS" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
